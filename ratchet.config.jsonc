// The gates of this repository: the repository gates itself with the binary
// it ships.
//
// The engine owns the baseline, the direction, the monotonicity and the
// report (SPEC 3); `scripts/count.sh` owns the counting.  A rule whose
// count is zero today is a boolean gate — no occurrence may appear — and
// only `dependency-count` is a ratchet: its baseline may only decrease.
[
  { "preset": "agent-rules" },
  {
    "name": "ratchet-cli",
    "release": {
      // The changelog is written by hand up to 0.2.0; from that version on
      // every block is machine-written (`ratchet release`).
      "changelog": "CHANGELOG.md",
      "changelogFrom": "0.2.0",
      "tagPrefix": "v",
      // The version lives in the manifest of the build tool — the one place
      // it is written down.
      "version": { "path": "Cargo.toml", "format": "toml", "section": "package", "key": "version" }
    },
    "rules": {
      "dependency-count": {
        "class": "supply-chain debt",
        "incident": "the number of declared dependencies was written down nowhere, so the supply-chain debt could only grow silently — this baseline records the count of today",
        "unit": "dependency entries",
        "direction": "ceiling",
        "description": "the counted scope is the dependency sections of this package — `[dependencies]`, `[dev-dependencies]`, `[build-dependencies]` and their target-specific forms — in the inline and in the table form; `[workspace.dependencies]` is not a dependency of this package. An entry is a key at the start of a line: a multi-line inline table whose continuation starts at column 0 is counted twice",
        "count": { "command": ["sh", "scripts/count.sh", "dependency-count"] }
      },
      "no-machine-path-in-source": {
        "class": "a machine-specific path baked into the source",
        "incident": "prevention: no instance in this project yet — a home path in the source would make the build machine-specific",
        "unit": "occurrences",
        "direction": "ceiling",
        "description": "the counted scope is every `*.rs` file under `src/` — the crate's own sources, the inline `#[cfg(test)]` modules included; the integration tests under `tests/` are a separate crate and are not counted. The count is a textual match — a path in a comment or in a string counts too, so the count can only be too high, never too low",
        "count": { "command": ["sh", "scripts/count.sh", "no-machine-path-in-source"] }
      },
      "no-panic-in-source": {
        "class": "crash instead of a clean failure",
        "incident": "prevention: no instance in this project yet — a panic is not a clean failure: the tool must report the problem, never crash",
        "unit": "occurrences",
        "direction": "ceiling",
        "description": "the counted scope is every `*.rs` file under `src/` — the crate's own sources, the inline `#[cfg(test)]` modules included; the integration tests under `tests/` are a separate crate and are not counted. The count is a textual match — the word in a comment or in a string counts too, so the count can only be too high, never too low",
        "count": { "command": ["sh", "scripts/count.sh", "no-panic-in-source"] }
      },
      "no-unfinished-marker": {
        "class": "unfinished work",
        "incident": "prevention: no instance in this project yet — `todo!` and `unimplemented!` are unfinished paths, not decisions; the word in a comment or in a string is not a marker either, but the count is textual and counts it anyway",
        "unit": "occurrences",
        "direction": "ceiling",
        "description": "the counted scope is every `*.rs` file under `src/` — the crate's own sources, the inline `#[cfg(test)]` modules included; the integration tests under `tests/` are a separate crate and are not counted. The count is a textual match — the word in a comment or in a string counts too, so the count can only be too high, never too low",
        "count": { "command": ["sh", "scripts/count.sh", "no-unfinished-marker"] }
      },
      "no-unsafe-in-source": {
        "class": "unsafe code",
        "incident": "prevention: no instance in this project yet — the engine must stay free of `unsafe`, so that a review can rely on safe Rust",
        "unit": "occurrences",
        "direction": "ceiling",
        "description": "the counted scope is every `*.rs` file under `src/` — the crate's own sources, the inline `#[cfg(test)]` modules included; the integration tests under `tests/` are a separate crate and are not counted. The count is a textual match — the word in a comment or in a string counts too, so the count can only be too high, never too low",
        "count": { "command": ["sh", "scripts/count.sh", "no-unsafe-in-source"] }
      }
    }
  }
]
